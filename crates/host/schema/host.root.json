{
  "evaluator": "external",
  "interface": {
    "description": "root entry：根在系统内交任务、取结果",
    "signature": {
      "in": {},
      "out": {}
    },
    "provides": {
      "done": {
        "description": "收结束状态",
        "in": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ok": {
                  "enum": [
                    true
                  ]
                },
                "value": {},
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Bundle ID"
                  },
                  "description": "显式依赖根的集合；ID 排序、无重复"
                }
              },
              "required": [
                "ok",
                "value",
                "dependencies"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ok": {
                  "enum": [
                    false
                  ]
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "description": "契约层的 use、denied、type、terminated，或 Language 定义的"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {}
                  },
                  "required": [
                    "kind",
                    "message",
                    "data"
                  ],
                  "additionalProperties": false
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Bundle ID"
                  },
                  "description": "显式依赖根的集合；ID 排序、无重复"
                }
              },
              "required": [
                "ok",
                "error",
                "dependencies"
              ],
              "additionalProperties": false
            }
          ]
        },
        "attach": {
          "additionalProperties": false
        }
      }
    },
    "requires": {
      "pack": {
        "description": "把内容和本次交付的依赖建立为 Bundle，返回 ID 并交付该根",
        "in": {
          "type": "object",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "json": {}
                  },
                  "required": [
                    "json"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "base64": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "base64"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "parts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "parts"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Bundle ID"
              },
              "description": "显式依赖根的集合；ID 排序、无重复"
            }
          },
          "required": [
            "content",
            "dependencies"
          ],
          "additionalProperties": false
        },
        "attach": {
          "additionalProperties": false
        },
        "out": {
          "value": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "attach": {
            "additionalProperties": false
          }
        }
      },
      "construct": {
        "description": "检查完整 Definition Bundle；成功事实属于该对象",
        "in": {
          "type": "object",
          "properties": {
            "definition": {
              "type": "string"
            }
          },
          "required": [
            "definition"
          ],
          "additionalProperties": false
        },
        "attach": {
          "additionalProperties": false
        },
        "out": {
          "value": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "attach": {
            "additionalProperties": false
          }
        }
      },
      "instantiate": {
        "description": "实例化已构造的 Definition，输入依赖来自本次交付；Required port 从附带或 self 接上",
        "in": {
          "type": "object",
          "properties": {
            "definition": {
              "type": "string"
            },
            "input": {
              "type": "object",
              "properties": {
                "value": {},
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Bundle ID"
                  },
                  "description": "显式依赖根的集合；ID 排序、无重复"
                }
              },
              "required": [
                "value",
                "dependencies"
              ],
              "additionalProperties": false
            },
            "seats": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "definition": {
                    "type": "string"
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "value": {},
                      "dependencies": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "Bundle ID"
                        },
                        "description": "显式依赖根的集合；ID 排序、无重复"
                      }
                    },
                    "required": [
                      "value",
                      "dependencies"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "definition"
                ],
                "additionalProperties": false
              }
            },
            "self": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Required port → port/<自己Provided port> 或 look"
            }
          },
          "required": [
            "definition",
            "input",
            "seats",
            "self"
          ],
          "additionalProperties": false
        },
        "attach": {
          "additionalProperties": true
        },
        "out": {
          "value": {
            "type": "null"
          },
          "attach": {
            "additionalProperties": true
          }
        }
      },
      "engine": {
        "description": "请求一次模型生成；提供者和模型由这份 Reference 决定",
        "in": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/message"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "input": {
                    "type": "object"
                  }
                },
                "required": [
                  "name",
                  "description",
                  "input"
                ],
                "additionalProperties": false
              }
            },
            "max_output_tokens": {
              "type": "integer"
            },
            "timeout": {
              "type": "integer"
            }
          },
          "required": [
            "system",
            "messages",
            "tools"
          ],
          "additionalProperties": false,
          "$defs": {
            "call": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input": {}
              },
              "required": [
                "id",
                "name",
                "input"
              ],
              "additionalProperties": false
            },
            "message": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "role": {
                      "enum": [
                        "user"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "role": {
                      "enum": [
                        "assistant"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "reasoning": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "calls": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/call"
                      }
                    }
                  },
                  "required": [
                    "role",
                    "text",
                    "reasoning",
                    "calls"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "role": {
                      "enum": [
                        "tool"
                      ]
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "output": {},
                          "is_error": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "output",
                          "is_error"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "role",
                    "results"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "attach": {
          "additionalProperties": false
        },
        "out": {
          "value": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "reasoning": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "input": {}
                  },
                  "required": [
                    "id",
                    "name",
                    "input"
                  ],
                  "additionalProperties": false
                }
              },
              "finish": {
                "enum": [
                  "stop",
                  "length",
                  "tool_calls",
                  "content_filter",
                  "other"
                ]
              },
              "usage": {
                "type": "object",
                "properties": {
                  "input": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "input",
                  "output"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "text",
              "reasoning",
              "calls",
              "finish",
              "usage"
            ],
            "additionalProperties": false
          },
          "attach": {
            "additionalProperties": false
          }
        }
      },
      "exec": {
        "description": "从显式快照建立独立环境，运行命令，交付稳定产物；不自动采用结果",
        "in": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "string"
            },
            "mounts": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stdin": {
              "type": "string"
            },
            "timeout": {
              "type": "integer",
              "description": "秒，正数，至多 600"
            }
          },
          "required": [
            "snapshot",
            "mounts",
            "argv",
            "stdin",
            "timeout"
          ],
          "additionalProperties": false
        },
        "attach": {
          "additionalProperties": false
        },
        "out": {
          "value": {
            "type": "object",
            "properties": {
              "exit": {
                "type": "integer"
              },
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "timed_out": {
                "type": "boolean"
              },
              "truncated": {
                "type": "boolean"
              },
              "snapshot": {
                "type": "string"
              }
            },
            "required": [
              "exit",
              "stdout",
              "stderr",
              "timed_out",
              "truncated",
              "snapshot"
            ],
            "additionalProperties": false
          },
          "attach": {
            "additionalProperties": false
          }
        }
      },
      "back": {
        "description": "收结束状态",
        "in": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ok": {
                  "enum": [
                    true
                  ]
                },
                "value": {},
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Bundle ID"
                  },
                  "description": "显式依赖根的集合；ID 排序、无重复"
                }
              },
              "required": [
                "ok",
                "value",
                "dependencies"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ok": {
                  "enum": [
                    false
                  ]
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "description": "契约层的 use、denied、type、terminated，或 Language 定义的"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {}
                  },
                  "required": [
                    "kind",
                    "message",
                    "data"
                  ],
                  "additionalProperties": false
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Bundle ID"
                  },
                  "description": "显式依赖根的集合；ID 排序、无重复"
                }
              },
              "required": [
                "ok",
                "error",
                "dependencies"
              ],
              "additionalProperties": false
            }
          ]
        },
        "attach": {
          "additionalProperties": false
        }
      }
    }
  }
}
