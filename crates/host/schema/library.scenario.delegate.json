    "sha256:lssend0": {
      "system": "你在 /work 里改代码。改完用一两句话说清改了什么。",
      "messages": [
        {
          "role": "user",
          "text": "修好 a.py"
        }
      ],
      "tools": [
        {
          "name": "read_file",
          "description": "读快照里的一个文件。",
          "input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "相对 /work 的路径。"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "write_file",
          "description": "写入文件并采用产物。",
          "input": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "相对 /work 的路径。"
              },
              "content": {
                "type": "string",
                "description": "文件的新内容。"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "run",
          "description": "运行 shell 命令并采用稳定产物，失败也保留改动。",
          "input": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "交给 sh -c 的命令。"
              },
              "timeout": {
                "type": "integer",
                "description": "秒，最多 600。"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
