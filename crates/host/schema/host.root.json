{
  "evaluator": "external",
  "interface": {
    "description": "root entry：根在系统内交任务、取结果",
    "signature": {
      "in": {
        "type": "object",
        "description": "这次运行：宿主在诞生时记下，恢复时从 Journal 取回，不再读命令行与磁盘",
        "properties": {
          "definition": {
            "type": "string",
            "description": "被运行的 Definition 的 Bundle ID"
          },
          "input": {
            "description": "交给它的输入值，形状是它的 Signature 的 in；目录字段已经填成导入后的 Bundle ID"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "输入用到的 Bundle，已排序去重；不含 Definition"
          },
          "directory": {
            "type": "string",
            "description": "取回结果目录时看哪个字段：结束值里的这个字段是结果目录的 Bundle ID；空串是没有"
          }
        },
        "required": [
          "definition",
          "input",
          "dependencies",
          "directory"
        ],
        "additionalProperties": false
      },
      "out": {}
    },
    "provides": {
      "done": {
        "description": "收结束状态",
        "in": {
          "$block": "definition.outcome"
        },
        "attach": {
          "additionalProperties": false
        }
      }
    },
    "requires": {
      "pack": {
        "$block": "reference.kernel#/pack"
      },
      "construct": {
        "$block": "reference.kernel#/construct"
      },
      "instantiate": {
        "$block": "reference.kernel#/instantiate"
      },
      "engine": {
        "$block": "model.generate"
      },
      "exec": {
        "$block": "directory.exec"
      },
      "infer": {
        "$block": "definition.infer"
      },
      "back": {
        "$block": "host.root#/interface/provides/done"
      }
    }
  }
}
