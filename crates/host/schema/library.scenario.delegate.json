    "sha256:ls": {
      "$bundle": {
        "language": "lang0@1",
        "interface": {
          "description": "改一处代码，交回总结与改过的 Bundle。",
          "signature": {
            "in": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string"
                },
                "snapshot": {
                  "type": "string"
                }
              },
              "required": [
                "task",
                "snapshot"
              ],
              "additionalProperties": false
            },
            "out": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string"
                },
                "snapshot": {
                  "type": "string"
                }
              },
              "required": [
                "summary",
                "snapshot"
              ],
              "additionalProperties": false
            }
          },
          "provides": {},
          "requires": {
            "engine": {
              "$block": "model.generate"
            },
            "exec": {
              "$block": "directory.exec"
            }
          }
        },
        "body": {
          "source": {
            "$file": "library/s.py"
          },
          "modules": "sha256:lrepo"
        }
      },
      "dependencies": [
        "sha256:lrepo"
      ]
    },
    "sha256:lw0": {
      "$bundle": {
        "language": "lang0@1",
        "interface": {
          "description": "改仓库里的代码，必要时交办给 Agent。",
          "provides": {
            "$block": "host.root#/interface/provides"
          },
          "requires": {
            "$block": "host.root#/interface/requires"
          },
          "signature": {
            "in": {
              "additionalProperties": false,
              "properties": {
                "snapshot": {
                  "type": "string"
                },
                "task": {
                  "description": "要做的事。",
                  "type": "string"
                },
                "worker": {
                  "description": "预置的 s 的 Definition ID。",
                  "type": "string"
                }
              },
              "required": [
                "task",
                "worker",
                "snapshot"
              ],
              "type": "object"
            },
            "out": {
              "additionalProperties": false,
              "properties": {
                "snapshot": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "summary",
                "snapshot"
              ],
              "type": "object"
            }
          }
        },
        "body": {
          "source": {
            "$file": "library/w0.py"
          },
          "modules": "sha256:lrepo"
        }
      },
      "dependencies": [
        "sha256:lrepo"
      ]
    },
